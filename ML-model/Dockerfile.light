# Use Python 3.9 slim image for smaller size
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for pip
ENV PIP_DEFAULT_TIMEOUT=600
ENV PIP_RETRIES=5
ENV PIP_TIMEOUT=600
ENV PYTHONUNBUFFERED=1

# Copy lightweight requirements first for better caching
COPY src/requirements-light.txt requirements.txt

# Install Python dependencies with retry logic
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --retries 5 --timeout 600 -r requirements.txt

# Copy the application code
COPY . .

# Create a non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Run the simple application (no ML dependencies)
CMD ["python", "src/app-simple.py"]
